# Local Playwright E2E config (optional — copy to playwright/.env)
#
# Authentication no longer uses a username/password/security token anywhere.
# The suite reads an access token out of the Salesforce CLI's already
# authenticated org instead (see support/salesforceSession.ts):
#
#   sf org login web --alias partner-dev --set-default
#   npm run test:e2e
#
# SF_TARGET_ORG: optional CLI alias/username to use instead of the CLI's
# default org. CI sets this after `sf org login sfdx-url` with SFDX_AUTH_URL.
SF_TARGET_ORG=

# SF_BASE_URL: optional override for the Dev Org's Lightning domain used as
# Playwright's baseURL. Defaults to https://chickentightslabs-dev-ed.develop.lightning.force.com.
SF_BASE_URL=
