<?xml version="1.0" encoding="UTF-8" ?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>Staff Utilisation</name>
    <description
  >How many classes is each trainer running, where, and how much capacity are they covering? Groups by the Assigned Trainer user lookup on Scheduled_Session__c — there is no Staff__c object yet, so this is trainer utilisation by Salesforce user, not by staff record. Re-point to Staff__c once the staff model decision lands.</description>
    <format>Summary</format>
    <reportType>Scheduled_Session__c</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Assigned_Trainer__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Franchise_Location__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>Max_Capacity__c</field>
    </columns>
    <filter>
        <criteriaItems>
            <column>Session_Status__c</column>
            <operator>notEqual</operator>
            <value>Cancelled</value>
        </criteriaItems>
    </filter>
</Report>
