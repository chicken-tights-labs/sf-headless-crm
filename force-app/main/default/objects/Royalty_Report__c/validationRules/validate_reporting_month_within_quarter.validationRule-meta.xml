<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validate_reporting_month_within_quarter</fullName>
    <active>true</active>
    <description>validate_reporting_month_within_quarter</description>
    <errorConditionFormula>Reporting_Month__c &lt; TODAY() - 90</errorConditionFormula>
    <errorMessage>Reporting month must be within last quarter</errorMessage>
</ValidationRule>