<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validate_paid_not_editable</fullName>
    <active>true</active>
    <description>validate_paid_not_editable</description>
    <errorConditionFormula>Status__c = 'Paid' AND ISCHANGED(Status__c)</errorConditionFormula>
    <errorMessage>Cannot modify a paid royalty report</errorMessage>
</ValidationRule>