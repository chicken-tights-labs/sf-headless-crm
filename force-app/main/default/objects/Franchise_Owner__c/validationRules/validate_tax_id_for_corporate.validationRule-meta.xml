<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validate_tax_id_for_corporate</fullName>
    <active>true</active>
    <description>validate_tax_id_for_corporate</description>
    <errorConditionFormula>$RecordType.Name = 'Corporate_Entity' AND ISBLANK(Tax_ID__c)</errorConditionFormula>
    <errorMessage>Tax ID is required for corporate owners</errorMessage>
</ValidationRule>