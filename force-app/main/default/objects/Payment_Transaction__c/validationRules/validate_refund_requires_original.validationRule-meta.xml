<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validate_refund_requires_original</fullName>
    <active>true</active>
    <description>validate_refund_requires_original</description>
    <errorConditionFormula>Payment_Type__c = 'Refund' AND ISBLANK(TEXT(CreatedById))</errorConditionFormula>
    <errorMessage>Refund must reference original transaction</errorMessage>
</ValidationRule>