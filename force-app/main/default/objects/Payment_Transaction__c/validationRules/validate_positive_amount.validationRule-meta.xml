<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validate_positive_amount</fullName>
    <active>true</active>
    <description>validate_positive_amount</description>
    <errorConditionFormula>Amount__c &lt;= 0 AND NOT(Payment_Type__c = 'Refund')</errorConditionFormula>
    <errorMessage>Amount must be positive</errorMessage>
</ValidationRule>