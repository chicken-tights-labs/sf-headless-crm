<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validate_start_date_past</fullName>
    <active>true</active>
    <description>validate_start_date_past</description>
    <errorConditionFormula>Start_Date__c > TODAY()</errorConditionFormula>
