<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validate_signature_timestamp_past</fullName>
    <active>true</active>
    <description>validate_signature_timestamp_past</description>
    <errorConditionFormula>Signature_Timestamp__c &gt; NOW()</errorConditionFormula>
    <errorMessage>Signature timestamp cannot be in the future</errorMessage>
</ValidationRule>