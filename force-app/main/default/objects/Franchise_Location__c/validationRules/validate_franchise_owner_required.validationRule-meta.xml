<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validate_franchise_owner_required</fullName>
    <active>true</active>
    <description>validate_franchise_owner_required</description>
    <errorConditionFormula>NOT(Is_Corporate__c) && ISBLANK(Franchise_Owner__c)</errorConditionFormula>
    <errorMessage>Franchise Owner must be specified for franchise-owned locations</errorMessage>
</ValidationRule>