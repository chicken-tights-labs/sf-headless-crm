<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validate_unqualified_requires_reason</fullName>
    <active>true</active>
    <description>validate_unqualified_requires_reason</description>
    <errorConditionFormula>Lead_Status__c = 'Unqualified' AND ISBLANK(Notes__c)</errorConditionFormula>
    <errorMessage>Reason required when marking lead as unqualified</errorMessage>
</ValidationRule>