<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validate_active_requires_trainer</fullName>
    <active>true</active>
    <description>validate_active_requires_trainer</description>
    <errorConditionFormula>Session_Status__c = 'Scheduled' AND ISBLANK(Assigned_Trainer__c)</errorConditionFormula>
    <errorMessage>Active sessions must have an assigned trainer</errorMessage>
</ValidationRule>