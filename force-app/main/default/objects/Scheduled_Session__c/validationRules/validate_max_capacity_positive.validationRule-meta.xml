<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validate_max_capacity_positive</fullName>
    <active>true</active>
    <description>validate_max_capacity_positive</description>
    <errorConditionFormula>Max_Capacity__c &lt;= 0</errorConditionFormula>
