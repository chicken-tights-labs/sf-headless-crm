<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Convert_Lead</name>
        <label>Convert Lead</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <actionName>EPIC01_LeadConversion_Action</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Result_Decision</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>leadId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>EPIC01_LeadConversion_Action</nameSegment>
        <outputParameters>
            <assignToReference>conversionMessage</assignToReference>
            <name>message</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>conversionSuccess</assignToReference>
            <name>success</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>newMemberId</assignToReference>
            <name>memberId</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>58.0</apiVersion>
    <decisions>
        <name>Result_Decision</name>
        <label>Result Decision</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Error_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Failed</defaultConnectorLabel>
        <rules>
            <name>Succeeded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>conversionSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Converted_Intro_Screen</targetReference>
            </connector>
            <label>Succeeded</label>
        </rules>
    </decisions>
    <description
  >EPIC04-US-F002: Lead Convert to Member + pay. Converts via EPIC01_LeadConversion_Action, then runs EPIC01 Process Membership Payment (US-F004) so Active comes from the payment engine.</description>
    <environments>Default</environments>
    <interviewLabel
  >EPIC04 Convert Lead And Pay {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EPIC04 Convert Lead And Pay</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Converted_Intro_Screen</name>
        <label>Lead Converted — Continue to Payment</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Run_Payment</targetReference>
        </connector>
        <fields>
            <name>ConvertedIntroText</name>
            <fieldText
      >&lt;p&gt;{!conversionMessage}&lt;/p&gt;&lt;p&gt;The member is &lt;strong&gt;Prospect&lt;/strong&gt; until payment succeeds. Next: confirm the tier and take payment (same screens as Process Membership Payment).&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
